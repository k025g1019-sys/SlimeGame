// フェーズ構成（スライム（仮題））
// ・配列 "phases" の順にフェーズが進む。フェーズ k は層 k の輪（奥へ k 番目）で戦う
// ・追加・削除・入れ替えは要素を足す・消す・並べ替えるだけ（層の数＝フェーズ数は自動で決まる）
// ・最後のフェーズをクリアするとゲームクリア（最後がボスならボスの撃破演出のあとでクリア）
// ・実行中は Game Debug の「Reload Phases」で読み直せる（書き間違い＝知らない項目名・範囲外の値なども赤字で表示され、今の構成のまま動く）
// ・このファイルが無い・壊れているときは PhaseData.cpp の MakeDefault（この初期内容と同じ）で動く
//
// 【フェーズの項目】
//   "type"      : "wave"（雑魚を全員倒すとクリア） / "boss"（ボスの体力を0にするとクリア。残った雑魚はまとめて消える）
//   "name"      : 表示名（英数字のみ・24文字まで。日本語は画面に出せない）。省略すると "WAVE n" / "BOSS n"
//   "bossLevel" : ボスの強さ 1～3（boss のみ。攻撃の間隔が短くなり、1回に投げる弾が レベル×1 発になる。省略=1）
//   "hp"        : ボスの体力 1～99（boss のみ。跳ね返した爆弾1発で1減る。省略=3）
//   "enemies"   : 雑魚の配置の配列（wave は1体以上必要。boss は省略可）
//
// 【雑魚の項目】
//   "type"     : "walker"（輪に沿って歩く） / "shooter"（その場でトゲ弾を撃つ） / "bomber"（その場で爆弾を転がす）
//   "angleDeg" : 出現する角度（度）。0=右、90=上、180=左、270(-90)=下。カメラから見て反時計回りに増える
//                どのフェーズもスライムは -90（下）から始まり（層の移動中に下へ移る）、反時計回り（画面の下では右へ）に進み続ける
//                （約26度/秒）。出現の瞬間にスライムから35度以内なら、35度の位置までずらして出る（Enemy > SpawnSafeAngleDeg）
//   "delay"    : フェーズ開始から出現までの秒数（省略=0）
//   "dir"      : walker の歩く向き。-1=時計回り（スライムと向かい合う）、1=反時計回り（省略=-1）
{
	"phases": [
		{
			"type": "wave",
			"name": "WAVE 1",
			// 最初の walker は正面から来る（平らになって乗せ、離して取り込む練習。PHASE 1 のバナーが消えてから2秒ほどで届く）。
			// bomber はボス1の前に跳ね返しを覚えさせるため
			"enemies": [
				{ "type": "walker", "angleDeg": 45, "delay": 1.5 },
				{ "type": "shooter", "angleDeg": 90, "delay": 1.0 },
				{ "type": "bomber", "angleDeg": 120, "delay": 3.0 },
				{ "type": "walker", "angleDeg": 200, "delay": 4.0 }
			]
		},
		{
			"type": "boss",
			"name": "BOSS 1",
			"bossLevel": 1,
			"hp": 3
		},
		{
			"type": "wave",
			"name": "WAVE 2",
			"enemies": [
				{ "type": "walker", "angleDeg": 30, "delay": 0 },
				{ "type": "bomber", "angleDeg": 90, "delay": 1.0 },
				{ "type": "shooter", "angleDeg": 150, "delay": 0.5 },
				{ "type": "shooter", "angleDeg": 300, "delay": 2.0 },
				{ "type": "bomber", "angleDeg": 230, "delay": 3.0 }
			]
		},
		{
			"type": "boss",
			"name": "BOSS 2",
			"bossLevel": 2,
			"hp": 4,
			// ボスフェーズにも雑魚を出せる（クリア条件はボスの体力0のみ）
			"enemies": [
				{ "type": "walker", "angleDeg": 90, "delay": 3.0 }
			]
		},
		{
			"type": "wave",
			"name": "WAVE 3",
			"enemies": [
				{ "type": "walker", "angleDeg": 0, "delay": 0 },
				{ "type": "walker", "angleDeg": 180, "delay": 1.0, "dir": 1 },
				{ "type": "shooter", "angleDeg": 60, "delay": 1.5 },
				{ "type": "bomber", "angleDeg": 120, "delay": 2.0 },
				{ "type": "shooter", "angleDeg": 240, "delay": 2.5 },
				{ "type": "bomber", "angleDeg": 300, "delay": 4.0 }
			]
		},
		{
			"type": "boss",
			"name": "BOSS 3",
			"bossLevel": 3,
			"hp": 5,
			"enemies": [
				{ "type": "shooter", "angleDeg": 90, "delay": 2.0 },
				{ "type": "bomber", "angleDeg": 200, "delay": 4.0 }
			]
		}
	]
}
